# NOTA: Este workflow fue realizado como parte de un challenge laboral y quedó
# aquí solo como referencia para quien lo necesite revisar.
# Se renombró a "playwright.yml.disabled" para que GitHub Actions no lo
# reconozca como workflow activo y no se ejecute automáticamente (push, PR,
# schedule) ni pueda dispararse manualmente.
# Para reactivarlo, renombrar de vuelta a "playwright.yml".
name: Playwright Tests
on:
  push:
    branches: [ main, master ]
  pull_request:
    branches: [ main, master ]
  schedule:
    - cron: '0 3 * * *'
  workflow_dispatch:
jobs:
  smoke:
    if: github.event_name == 'push' || github.event_name == 'pull_request'
    timeout-minutes: 60
    runs-on: ubuntu-latest
    steps:
    - uses: actions/checkout@v4
    - uses: actions/setup-node@v4
      with:
        node-version: lts/*
    - name: Install dependencies
      run: npm ci
    - name: Install Playwright Browsers
      run: npx playwright install --with-deps
    - name: Run smoke tests
      run: npm run test:smoke
    - uses: actions/upload-artifact@v4
      if: ${{ !cancelled() }}
      with:
        name: playwright-report-smoke
        path: playwright-report/
        retention-days: 30

  regression:
    if: github.event_name == 'schedule' || github.event_name == 'workflow_dispatch'
    timeout-minutes: 60
    runs-on: ubuntu-latest
    steps:
    - uses: actions/checkout@v4
    - uses: actions/setup-node@v4
      with:
        node-version: lts/*
    - name: Install dependencies
      run: npm ci
    - name: Install Playwright Browsers
      run: npx playwright install --with-deps
    - name: Run regression tests
      run: npm run test:regression
    - uses: actions/upload-artifact@v4
      if: ${{ !cancelled() }}
      with:
        name: playwright-report-regression
        path: playwright-report/
        retention-days: 30
